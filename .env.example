# Signs the frontend's session cookie. Required: the frontend refuses to start
# in production without it, and changing it signs every account out.
SESSION_SECRET=

# Optional overrides for the URLs the API advertises. Change these when the
# stack sits behind a proxy or on a real domain, keeping them in step. The UI
# URL is also the origin the API trusts for passkey ceremonies and magic-link
# returns, which is why the compose stack passes it as the allowed CORS origin.
# TRIFLARE_PUBLIC_BASE_URL=http://localhost:3000
# TRIFLARE_UI_PUBLIC_BASE_URL=http://localhost:3001
