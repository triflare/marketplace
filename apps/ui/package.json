{
  "name": "@triflare/marketplace-ui",
  "private": true,
  "version": "1.1.0",
  "description": "The web frontend for Triflare Marketplace, a registry of TurboWarp extensions built with Triflare Extend.",
  "type": "module",
  "author": "Triflare",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/triflare/marketplace.git"
  },
  "scripts": {
    "dev": "react-router dev --port 3001",
    "build": "react-router build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "react-router typegen && tsc -b",
    "check": "npm run typecheck && npm run build",
    "test:e2e": "playwright test",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "react-router-serve ./build/server/index.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "diff": "^8.0.4",
    "isbot": "^5",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "spdx-license-list": "^6.12.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "yaml": "^2.9.1"
  }
}
