# The API root the app server calls. The browser never talks to the registry
# directly. Development defaults to http://localhost:3000/v2, production to
# https://twexts.sdisk.us/api/v2.
TWEXTHUB_API_URL=https://twexts.sdisk.us/api/v2

# Signs the HTTP-only session cookie. Required in production: changing it signs
# every account out. A development fallback is used when it is unset.
SESSION_SECRET=

# Optional. Builds install links, badges, and the copyable badge Markdown in the
# browser. Keep its origin in step with TWEXTHUB_API_URL.
VITE_TWEXTHUB_API_URL=https://twexts.sdisk.us/api/v2
