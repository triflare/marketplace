{
  "name": "@triflare/marketplace-api",
  "version": "1.1.0",
  "private": true,
  "description": "A registry of TurboWarp extensions built with Triflare Extend",
  "homepage": "https://github.com/triflare/marketplace#readme",
  "bugs": {
    "url": "https://github.com/triflare/marketplace/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/triflare/marketplace.git"
  },
  "license": "Apache-2.0",
  "author": "Triflare",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node scripts/test-run.mjs",
    "test:setup": "docker compose -f compose.test.yml up -d --wait && npm run test:db:create",
    "test:db:create": "node scripts/test-db.mjs",
    "test:teardown": "docker compose -f compose.test.yml down",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctoc": "doctoc --notitle .",
    "check": "npm run lint && npm run format:check && npm run check:prisma && npm run check:openapi && npm test",
    "check:prisma": "node scripts/check-prisma-usage.mjs",
    "check:openapi": "node scripts/lint-openapi.mjs",
    "generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/server": "^14.0.3",
    "@triflare/extend": "^0.2.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.12",
    "prisma": "^7.10.1",
    "semver": "^7.7.2",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "terser": "^5.51.2",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@lifelinejs/lifeline": "^0.1.0",
    "doctoc": "^2.5.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
